{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ospp-standard.org/schemas/v1/mqtt/diagnostics-notification.schema.json",
  "title": "DiagnosticsNotification",
  "description": "Notification from the station reporting diagnostics collection and upload progress.",
  "type": "object",
  "required": ["status"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["Collecting", "Uploading", "Uploaded", "Failed"]
    },
    "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Upload progress percentage. MUST be absent when status is Collecting, Uploaded, or Failed."
    },
    "fileName": {
      "type": "string",
      "maxLength": 256,
      "description": "Name of the diagnostics archive. Permitted on any status."
    },
    "errorText": {
      "type": "string",
      "maxLength": 128,
      "description": "Human-readable error description. REQUIRED when status is Failed, absent otherwise."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["Collecting", "Uploaded", "Failed"] } },
        "required": ["status"]
      },
      "then": {
        "properties": { "progress": false }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "Failed" } },
        "required": ["status"]
      },
      "then": {
        "required": ["errorText"]
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["Collecting", "Uploading", "Uploaded"] } },
        "required": ["status"]
      },
      "then": {
        "properties": { "errorText": false }
      }
    }
  ]
}
