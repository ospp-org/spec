{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ospp-standard.org/schemas/v1/mqtt/security-event.schema.json",
  "title": "SecurityEvent",
  "description": "Security-related event, used for alerting and audit logging. Two origins share this shape (profiles/security/security-event.md 2.1): the station-published EVENT, and the server-originated audit record, which is never published. FraudDetected is server-originated only: a station never emits it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "severity",
    "timestamp",
    "details"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^sec_[a-f0-9]{8,}$",
      "minLength": 12,
      "maxLength": 64
    },
    "type": {
      "type": "string",
      "enum": [
        "MacVerificationFailure",
        "CertificateError",
        "UnauthorizedAccess",
        "OfflinePassRejected",
        "ServerSignedAuthReplay",
        "TamperDetected",
        "BruteForceAttempt",
        "FirmwareIntegrityFailure",
        "FirmwareDowngradeAttempt",
        "HardwareFault",
        "SoftwareFault",
        "ClockSkew",
        "FraudDetected"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "Critical",
        "Error",
        "Warning",
        "Info"
      ]
    },
    "timestamp": {
      "$ref": "../common/timestamp.schema.json"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "FraudDetected" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "required": ["score", "factors", "band", "action", "offlineTxId", "userId", "stationId"],
            "properties": {
              "score": { "type": "number", "minimum": 0, "maximum": 1, "description": "The fraud score of 06-security.md 7.4: the sum of the factors that fired, capped at 1." },
              "factors": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["InvalidTimestamps", "DurationExceedsAllowance", "HighOfflineFrequency", "RapidConsecutive", "ExceedsPerTxLimit", "FirstUseOfStation", "CumulativeUsesExceeded", "CumulativeCreditsExceeded", "NegativeBalance"]
                },
                "description": "The 06-security.md 7.4 factors that fired, by identifier."
              },
              "band": { "type": "string", "enum": ["Review", "Alert", "Block"] },
              "action": { "type": "string", "enum": ["FlaggedForReview", "OfflineDisabledForUser", "UserBlocked"], "description": "The automated response taken for the band (06-security.md 7.4)." },
              "offlineTxId": { "$ref": "../common/offline-tx-id.schema.json" },
              "offlinePassId": { "$ref": "../common/offline-pass-id.schema.json" },
              "authId": { "type": "string", "pattern": "^auth_[a-f0-9]{8,}$", "minLength": 13, "maxLength": 64 },
              "userId": { "$ref": "../common/user-id.schema.json" },
              "stationId": { "$ref": "../common/station-id.schema.json" },
              "messageId": { "type": "string", "minLength": 1, "description": "messageId of the TransactionEvent REQUEST that carried the scored transaction. Absent when the app's receipt upload settled it (spec/profiles/offline/app-contract.md 4), which carries none; the record is keyed on offlineTxId either way (spec/profiles/offline/reconciliation.md 7)." }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "FraudDetected" }, "details": { "type": "object", "properties": { "band": { "const": "Review" } }, "required": ["band"] } },
        "required": ["type", "details"]
      },
      "then": { "properties": { "severity": { "const": "Warning" }, "details": { "type": "object", "properties": { "action": { "const": "FlaggedForReview" } } } } }
    },
    {
      "if": {
        "properties": { "type": { "const": "FraudDetected" }, "details": { "type": "object", "properties": { "band": { "const": "Alert" } }, "required": ["band"] } },
        "required": ["type", "details"]
      },
      "then": { "properties": { "severity": { "const": "Error" }, "details": { "type": "object", "properties": { "action": { "const": "OfflineDisabledForUser" } } } } }
    },
    {
      "if": {
        "properties": { "type": { "const": "FraudDetected" }, "details": { "type": "object", "properties": { "band": { "const": "Block" } }, "required": ["band"] } },
        "required": ["type", "details"]
      },
      "then": { "properties": { "severity": { "const": "Critical" }, "details": { "type": "object", "properties": { "action": { "const": "UserBlocked" } } } } }
    }
  ]
}
