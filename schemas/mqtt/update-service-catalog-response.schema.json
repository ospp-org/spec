{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ospp-standard.org/schemas/v1/mqtt/update-service-catalog-response.schema.json",
  "title": "UpdateServiceCatalogResponse",
  "description": "Response to an update-service-catalog request indicating whether the station accepted the new catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "Accepted",
        "Rejected"
      ]
    },
    "previousCatalogVersion": {
      "type": "string",
      "maxLength": 32,
      "description": "The catalog version this update replaced. REQUIRED when status is Accepted (update-service-catalog.md processing rule 3); the empty string is the legitimate value for a station that has never held a catalog."
    },
    "errorCode": {
      "type": "integer"
    },
    "errorText": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "maxLength": 128
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "Rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "errorCode",
          "errorText"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "previousCatalogVersion"
        ]
      }
    }
  ]
}
