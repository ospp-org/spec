{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ospp-standard.org/schemas/v1/ble/available-services.schema.json",
  "title": "AvailableServices",
  "description": "The station's service catalog per bay, served on BLE characteristic FFF2 by request and notification before the handshake (profiles/offline/ble-transport.md §4). Derived from the catalog the station holds: every bay it declared, each with the services the catalog binds to its programs, with their prices. Carries no availability - that is the Challenge's availableServices.",
  "type": "object",
  "required": [
    "bays"
  ],
  "additionalProperties": false,
  "properties": {
    "catalogVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "Version identifier of the service catalog the value is derived from. Absent while the station holds no catalog."
    },
    "bays": {
      "type": "array",
      "minItems": 1,
      "description": "Every bay the station declared at provisioning, each with the services its catalog binds to that bay's programs.",
      "items": {
        "type": "object",
        "required": [
          "bayId",
          "bayNumber",
          "services"
        ],
        "additionalProperties": false,
        "properties": {
          "bayId": {
            "$ref": "../common/bay-id.schema.json"
          },
          "bayNumber": {
            "type": "integer",
            "minimum": 1,
            "description": "Human-readable bay number"
          },
          "services": {
            "type": "array",
            "minItems": 0,
            "description": "The services the station's catalog binds to this bay's programs - none while the station holds no catalog.",
            "items": {
              "type": "object",
              "required": [
                "serviceId",
                "serviceName",
                "pricingType"
              ],
              "additionalProperties": false,
              "properties": {
                "serviceId": {
                  "$ref": "../common/service-id.schema.json"
                },
                "serviceName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "description": "Display name of the service"
                },
                "pricingType": {
                  "type": "string",
                  "enum": [
                    "PerMinute",
                    "Fixed"
                  ],
                  "description": "How this service is priced"
                },
                "priceCreditsPerMinute": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Price in credits per minute. Required when `pricingType` is `PerMinute`. MUST be absent otherwise."
                },
                "priceCreditsFixed": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Fixed price in credits. Required when `pricingType` is `Fixed`. MUST be absent otherwise."
                },
                "priceLocalPerMinute": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Optional price in local-currency minor units per minute — informational, for display only. MUST be absent when `pricingType` is `Fixed`."
                },
                "priceLocalFixed": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Optional fixed price in local-currency minor units — informational, for display only. MUST be absent when `pricingType` is `PerMinute`."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "pricingType": {
                        "const": "PerMinute"
                      }
                    },
                    "required": [
                      "pricingType"
                    ]
                  },
                  "then": {
                    "required": [
                      "priceCreditsPerMinute"
                    ],
                    "properties": {
                      "priceCreditsFixed": false,
                      "priceLocalFixed": false
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "pricingType": {
                        "const": "Fixed"
                      }
                    },
                    "required": [
                      "pricingType"
                    ]
                  },
                  "then": {
                    "required": [
                      "priceCreditsFixed"
                    ],
                    "properties": {
                      "priceCreditsPerMinute": false,
                      "priceLocalPerMinute": false
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
